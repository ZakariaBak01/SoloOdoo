<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_elmokrif_chantier" model="ir.module.category">
        <field name="name">EL MOKRIF Chantier</field>
        <field name="description">Operational and management access to EL MOKRIF chantier workflows.</field>
        <field name="sequence">35</field>
    </record>

    <record id="group_chantier_user" model="res.groups">
        <field name="name">Chantier User</field>
        <field name="category_id" ref="elmokrif_chantier.module_category_elmokrif_chantier"/>
        <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
    </record>

    <record id="group_chantier_sales_reader" model="res.groups">
        <field name="name">Chantier Sales Reference</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="comment">Read-only chantier references for sales quotations. This group does not expose chantier operational menus or actions.</field>
    </record>

    <record id="group_chantier_manager" model="res.groups">
        <field name="name">Chantier Manager</field>
        <field name="category_id" ref="elmokrif_chantier.module_category_elmokrif_chantier"/>
        <field name="implied_ids" eval="[(4, ref('elmokrif_chantier.group_chantier_user')), (4, ref('project.group_project_manager')), (4, ref('stock.group_stock_user')), (4, ref('base.group_partner_manager'))]"/>
    </record>
</odoo>
