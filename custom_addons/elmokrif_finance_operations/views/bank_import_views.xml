<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_elmokrif_bank_import_tree" model="ir.ui.view"><field name="name">elmokrif.bank.import.tree</field><field name="model">elmokrif.bank.import</field><field name="arch" type="xml"><tree><field name="name"/><field name="journal_id"/><field name="file_name"/><field name="line_count"/><field name="imported_at"/><field name="state" widget="badge"/></tree></field></record>
    <record id="view_elmokrif_bank_import_form" model="ir.ui.view"><field name="name">elmokrif.bank.import.form</field><field name="model">elmokrif.bank.import</field><field name="arch" type="xml"><form><header><button name="action_import_file" type="object" string="Import CSV" class="btn-primary" invisible="state != 'draft'"/><button name="action_close" type="object" string="Close" class="btn-primary" invisible="state != 'imported'"/><field name="state" widget="statusbar" statusbar_visible="draft,imported,closed"/></header><sheet><group><field name="name"/><field name="company_id"/><field name="journal_id"/><field name="file_name"/><field name="file_content" filename="file_name"/><field name="imported_at"/><field name="native_statement_id"/></group><field name="line_ids" readonly="1"><tree><field name="date"/><field name="reference"/><field name="partner_name"/><field name="amount"/><field name="matched_payment_id"/><field name="native_move_id"/><field name="is_natively_reconciled"/><field name="state" widget="badge"/></tree></field></sheet><chatter/></form></field></record>
    <record id="view_elmokrif_bank_import_line_form" model="ir.ui.view"><field name="name">elmokrif.bank.import.line.form</field><field name="model">elmokrif.bank.import.line</field><field name="arch" type="xml"><form><header><button name="action_suggest_payment" type="object" string="Suggest Exact Match" invisible="state != 'new'"/><button name="action_confirm_match" type="object" string="Confirm Match" class="btn-primary" invisible="state != 'new'"/><button name="action_mark_unmatched" type="object" string="Mark Unmatched" invisible="state != 'new'"/><button name="action_ignore" type="object" string="Ignore" invisible="state != 'new'"/><field name="state" widget="statusbar"/></header><sheet><group><field name="company_id" invisible="1"/><field name="import_id"/><field name="date"/><field name="amount"/><field name="reference"/><field name="partner_name"/><field name="account_number"/><field name="matched_payment_id" readonly="state != 'new'"/><field name="review_note" readonly="state != 'new'"/></group><group string="Native Accounting"><field name="native_statement_line_id"/><field name="native_move_id"/><field name="is_natively_reconciled"/><field name="native_reconciliation_ref"/></group></sheet></form></field></record>
    <record id="view_elmokrif_native_bank_statement_form" model="ir.ui.view"><field name="name">account.bank.statement.elmokrif.form</field><field name="model">account.bank.statement</field><field name="arch" type="xml"><form create="false" edit="false"><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="journal_id"/><field name="date"/><field name="reference"/></group><group><field name="balance_start"/><field name="balance_end"/><field name="balance_end_real"/></group></group><field name="line_ids"><tree create="false" edit="false" delete="false"><field name="date"/><field name="payment_ref"/><field name="partner_name"/><field name="amount"/><field name="is_reconciled"/><field name="move_id"/></tree><form create="false" edit="false" delete="false"><sheet><field name="suitable_journal_ids" invisible="1"/><group><field name="date"/><field name="journal_id"/><field name="payment_ref"/><field name="partner_name"/><field name="account_number"/><field name="amount"/><field name="is_reconciled"/><field name="move_id"/></group></sheet></form></field></sheet></form></field></record>
    <record id="action_elmokrif_bank_import" model="ir.actions.act_window"><field name="name">Bank Imports</field><field name="res_model">elmokrif.bank.import</field><field name="view_mode">tree,form</field></record>
    <record id="action_elmokrif_native_bank_statement" model="ir.actions.act_window"><field name="name">Bank Statements</field><field name="res_model">account.bank.statement</field><field name="view_mode">tree,form</field><field name="domain">[('journal_id.type', '=', 'bank')]</field><field name="context">{'journal_type': 'bank'}</field></record>
    <menuitem id="menu_elmokrif_bank_import" name="Bank Imports" parent="account.menu_finance" action="action_elmokrif_bank_import" groups="account.group_account_manager" sequence="50"/>
    <menuitem id="menu_elmokrif_native_bank_statement" name="Bank Statements" parent="account.menu_finance" action="action_elmokrif_native_bank_statement" groups="account.group_account_manager" sequence="51"/>
</odoo>
