<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_elmokrif_bank_import_tree" model="ir.ui.view"><field name="name">elmokrif.bank.import.tree</field><field name="model">elmokrif.bank.import</field><field name="arch" type="xml"><tree><field name="name"/><field name="journal_id"/><field name="file_name"/><field name="line_count"/><field name="imported_at"/><field name="state" widget="badge"/></tree></field></record>
    <record id="view_elmokrif_bank_import_form" model="ir.ui.view"><field name="name">elmokrif.bank.import.form</field><field name="model">elmokrif.bank.import</field><field name="arch" type="xml"><form><header><button name="action_import_file" type="object" string="Import CSV" class="btn-primary" invisible="state != 'draft'"/><button name="action_close" type="object" string="Close" class="btn-primary" invisible="state != 'imported'"/><field name="state" widget="statusbar" statusbar_visible="draft,imported,closed"/></header><sheet><group><field name="name"/><field name="company_id"/><field name="journal_id"/><field name="file_name"/><field name="file_content" filename="file_name"/><field name="imported_at"/></group><field name="line_ids" readonly="1"><tree><field name="date"/><field name="reference"/><field name="partner_name"/><field name="amount"/><field name="matched_payment_id"/><field name="state" widget="badge"/></tree></field></sheet><chatter/></form></field></record>
