<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_chantier" model="ir.ui.view">
        <field name="name">purchase.order.form.chantier</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="chantier_material_request_id" options="{'no_create': True}"/>
                <field name="chantier_id"/>
            </xpath>
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="chantier_selection_rationale" invisible="not chantier_material_request_id"/>
                <field name="chantier_amount_untaxed_company" invisible="not chantier_material_request_id"/>
                <field name="chantier_approval_required" invisible="1"/>
                <field name="chantier_approved_by_id" invisible="not chantier_material_request_id"/>
                <field name="chantier_approved_at" invisible="not chantier_material_request_id"/>
                <field name="chantier_approved_amount" invisible="not chantier_material_request_id"/>
            </xpath>
            <xpath expr="//field[@name='order_line']//field[@name='product_id']" position="after">
                <field name="chantier_material_request_line_id" optional="show" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>

