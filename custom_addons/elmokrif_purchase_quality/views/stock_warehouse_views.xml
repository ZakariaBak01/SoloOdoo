<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_warehouse_form_chantier_quality" model="ir.ui.view">
        <field name="name">stock.warehouse.form.chantier.quality</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lot_stock_id']" position="after">
                <field name="chantier_input_location_id" readonly="1"/>
                <field name="chantier_quality_location_id" readonly="1"/>
                <field name="chantier_quarantine_location_id" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
