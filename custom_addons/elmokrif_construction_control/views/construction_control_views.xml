<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Site issues -->
    <record id="view_construction_site_issue_tree" model="ir.ui.view">
        <field name="name">construction.site.issue.tree</field><field name="model">construction.site.issue</field>
        <field name="arch" type="xml"><tree decoration-danger="severity == 'critical' and state not in ['closed', 'cancelled']" decoration-warning="severity == 'high' and state not in ['closed', 'cancelled']">
            <field name="company_id" column_invisible="True"/><field name="name"/><field name="title"/><field name="chantier_id"/><field name="category"/><field name="severity" widget="badge"/><field name="responsible_id" widget="many2one_avatar_user"/><field name="due_date"/><field name="state" widget="badge"/>
        </tree></field>
    </record>
    <record id="view_construction_site_issue_form" model="ir.ui.view">
        <field name="name">construction.site.issue.form</field><field name="model">construction.site.issue</field>
        <field name="arch" type="xml"><form>
            <header>
                <button name="action_assign" type="object" string="Assign" class="oe_highlight" invisible="state != 'open'"/>
                <button name="action_resolve" type="object" string="Resolve" class="oe_highlight" invisible="state != 'assigned'"/>
                <button name="action_verify" type="object" string="Verify" class="oe_highlight" groups="elmokrif_construction_control.group_construction_control_manager" invisible="state != 'resolved'"/>
                <button name="action_close" type="object" string="Close" class="oe_highlight" invisible="state != 'verified'"/>
                <button name="action_create_rfi" type="object" string="Create RFI" invisible="state in ['closed', 'cancelled']"/>
                <button name="action_create_change_event" type="object" string="Create Change Event" invisible="state in ['closed', 'cancelled']"/>
                <field name="state" widget="statusbar" statusbar_visible="open,assigned,resolved,verified,closed"/>
            </header><sheet>
                <div class="oe_title"><label for="title"/><h1><field name="title" placeholder="Concise issue title"/></h1><field name="name"/></div>
                <group><group><field name="company_id"/><field name="chantier_id"/><field name="category"/><field name="severity"/></group>
                <group><field name="raised_by_id"/><field name="responsible_id" widget="many2one_avatar_user"/><field name="due_date"/><field name="location"/></group></group>
                <notebook><page string="Issue"><field name="description" placeholder="State the observed condition, required outcome, and location."/><field name="resolution" placeholder="Describe the completed corrective action."/></page>
                <page string="Evidence"><field name="attachment_ids" widget="many2many_binary"/></page>
                <page string="Related"><field name="rfi_ids" readonly="1"><tree><field name="name"/><field name="title"/><field name="response_due"/><field name="state"/></tree></field><field name="change_event_ids" readonly="1"><tree><field name="name"/><field name="title"/><field name="estimated_cost_impact"/><field name="state"/></tree></field></page></notebook>
            </sheet><div class="oe_chatter"><field name="message_follower_ids"/><field name="activity_ids"/><field name="message_ids"/></div>
        </form></field>
    </record>
    <record id="view_construction_site_issue_search" model="ir.ui.view"><field name="name">construction.site.issue.search</field><field name="model">construction.site.issue</field><field name="arch" type="xml"><search><field name="name"/><field name="title"/><field name="chantier_id"/><field name="responsible_id"/><filter name="open" string="Open" domain="[('state', 'not in', ['closed', 'cancelled'])]"/><filter name="critical" string="Critical" domain="[('severity', '=', 'critical')]"/><group expand="0" string="Group By"><filter name="group_chantier" string="Chantier" context="{'group_by': 'chantier_id'}"/><filter name="group_state" string="Status" context="{'group_by': 'state'}"/><filter name="group_category" string="Category" context="{'group_by': 'category'}"/></group></search></field></record>
    <record id="action_construction_site_issue" model="ir.actions.act_window"><field name="name">Site Issues</field><field name="res_model">construction.site.issue</field><field name="view_mode">tree,form</field><field name="context">{'search_default_open': 1}</field></record>

    <!-- RFIs -->
    <record id="view_construction_rfi_tree_tree" model="ir.ui.view"><field name="name">construction.rfi.tree</field><field name="model">construction.rfi</field><field name="arch" type="xml"><tree decoration-danger="is_overdue"><field name="company_id" column_invisible="True"/><field name="name"/><field name="title"/><field name="chantier_id"/><field name="priority" widget="badge"/><field name="responsible_id" widget="many2one_avatar_user"/><field name="response_due"/><field name="is_overdue" optional="hide"/><field name="cost_impact"/><field name="schedule_impact_days"/><field name="state" widget="badge"/></tree></field></record>
    <record id="view_construction_rfi_form" model="ir.ui.view"><field name="name">construction.rfi.form</field><field name="model">construction.rfi</field><field name="arch" type="xml"><form>
        <header><button name="action_submit" type="object" string="Submit" class="oe_highlight" invisible="state != 'draft'"/><button name="action_review" type="object" string="Start Review" class="oe_highlight" invisible="state != 'submitted'"/><button name="action_answer" type="object" string="Record Answer" class="oe_highlight" invisible="state != 'under_review'"/><button name="action_close" type="object" string="Close" class="oe_highlight" invisible="state != 'answered'"/><button name="action_create_change_event" type="object" string="Create Change Event" invisible="state not in ['answered', 'closed']"/><field name="state" widget="statusbar" statusbar_visible="draft,submitted,under_review,answered,closed"/></header>
        <sheet><div class="oe_title"><label for="title"/><h1><field name="title"/></h1><field name="name"/></div>
        <group><group><field name="company_id"/><field name="chantier_id"/><field name="issue_id"/><field name="boq_line_id"/></group><group><field name="raised_by_id"/><field name="responsible_id" widget="many2one_avatar_user"/><field name="priority"/><field name="response_due"/><field name="is_overdue" readonly="1"/></group></group>
        <notebook><page string="Question and Answer"><group><field name="question"/><field name="answer" required="state in ['answered', 'closed']"/></group></page><page string="Impact"><group><field name="cost_impact"/><field name="schedule_impact_days"/></group></page><page string="References"><field name="attachment_ids" widget="many2many_binary"/></page><page string="Audit"><group><field name="submitted_at"/><field name="answered_at"/><field name="closed_at"/></group></page></notebook>
        </sheet><div class="oe_chatter"><field name="message_follower_ids"/><field name="activity_ids"/><field name="message_ids"/></div></form></field></record>
    <record id="view_construction_rfi_search" model="ir.ui.view"><field name="name">construction.rfi.search</field><field name="model">construction.rfi</field><field name="arch" type="xml"><search><field name="name"/><field name="title"/><field name="chantier_id"/><field name="responsible_id"/><filter name="open" string="Open" domain="[('state', 'not in', ['closed', 'cancelled'])]"/><filter name="overdue" string="Overdue" domain="[('is_overdue', '=', True)]"/><group expand="0" string="Group By"><filter name="group_chantier" string="Chantier" context="{'group_by': 'chantier_id'}"/><filter name="group_state" string="Status" context="{'group_by': 'state'}"/><filter name="group_responsible" string="Responsible" context="{'group_by': 'responsible_id'}"/></group></search></field></record>
    <record id="action_construction_rfi" model="ir.actions.act_window"><field name="name">RFIs</field><field name="res_model">construction.rfi</field><field name="view_mode">tree,form</field><field name="context">{'search_default_open': 1}</field></record>

    <!-- Submittals -->
    <record id="view_construction_submittal_tree" model="ir.ui.view"><field name="name">construction.submittal.tree</field><field name="model">construction.submittal</field><field name="arch" type="xml"><tree decoration-danger="review_due &lt; context_today().strftime('%Y-%m-%d') and state in ['submitted', 'under_review']"><field name="company_id" column_invisible="True"/><field name="name"/><field name="title"/><field name="chantier_id"/><field name="submittal_type"/><field name="revision"/><field name="submitted_by_partner_id"/><field name="reviewer_id" widget="many2one_avatar_user"/><field name="review_due"/><field name="state" widget="badge"/></tree></field></record>
    <record id="view_construction_submittal_form" model="ir.ui.view"><field name="name">construction.submittal.form</field><field name="model">construction.submittal</field><field name="arch" type="xml"><form>
        <header><button name="action_submit" type="object" string="Submit" class="oe_highlight" invisible="state not in ['draft', 'rejected']"/><button name="action_review" type="object" string="Start Review" class="oe_highlight" invisible="state != 'submitted'"/><button name="action_approve" type="object" string="Approve" class="oe_highlight" invisible="state != 'under_review'"/><button name="action_approve_noted" type="object" string="Approve as Noted" invisible="state != 'under_review'"/><button name="action_reject" type="object" string="Reject / Revise" invisible="state != 'under_review'"/><button name="action_create_revision" type="object" string="New Revision" invisible="state not in ['approved', 'approved_noted', 'rejected']"/><field name="state" widget="statusbar" statusbar_visible="draft,submitted,under_review,approved,approved_noted,rejected"/></header>
        <sheet><div class="oe_title"><label for="title"/><h1><field name="title"/></h1><field name="name"/></div><group><group><field name="company_id"/><field name="chantier_id"/><field name="submittal_type"/><field name="revision"/><field name="specification_reference"/><field name="boq_line_id"/></group><group><field name="submitted_by_partner_id"/><field name="reviewer_id" widget="many2one_avatar_user"/><field name="review_due"/><field name="decision_by_id"/><field name="decision_at"/></group></group><notebook><page string="Submission"><field name="description"/><field name="attachment_ids" widget="many2many_binary"/></page><page string="Review"><field name="review_comment" required="state in ['approved', 'approved_noted', 'rejected']"/></page></notebook></sheet><div class="oe_chatter"><field name="message_follower_ids"/><field name="activity_ids"/><field name="message_ids"/></div></form></field></record>
    <record id="action_construction_submittal" model="ir.actions.act_window"><field name="name">Submittals</field><field name="res_model">construction.submittal</field><field name="view_mode">tree,form</field></record>

    <!-- Work packages -->
    <record id="view_construction_work_package_tree" model="ir.ui.view"><field name="name">construction.work.package.tree</field><field name="model">construction.work.package</field><field name="arch" type="xml"><tree decoration-danger="planned_finish &lt; context_today().strftime('%Y-%m-%d') and state not in ['accepted', 'closed', 'cancelled']" editable="bottom"><field name="company_id" column_invisible="True"/><field name="boq_id" column_invisible="True"/><field name="sequence" widget="handle"/><field name="name" readonly="1"/><field name="title"/><field name="chantier_id"/><field name="wbs_id" optional="show"/><field name="responsible_id" widget="many2one_avatar_user"/><field name="planned_start"/><field name="planned_finish"/><field name="planned_quantity"/><field name="installed_quantity"/><field name="unit"/><field name="progress_percent" widget="progressbar" readonly="1"/><field name="budget_total" sum="Total Budget" readonly="1"/><field name="state" widget="badge" readonly="1"/></tree></field></record>
    <record id="view_construction_work_package_form" model="ir.ui.view"><field name="name">construction.work.package.form</field><field name="model">construction.work.package</field><field name="arch" type="xml"><form>
        <header><button name="action_mark_ready" type="object" string="Confirm Readiness" class="oe_highlight" invisible="state != 'draft'"/><button name="action_release" type="object" string="Release" class="oe_highlight" invisible="state != 'ready'"/><button name="action_start" type="object" string="Start / Resume" class="oe_highlight" invisible="state not in ['released', 'on_hold']"/><button name="action_hold" type="object" string="Put on Hold" invisible="state != 'in_progress'"/><button name="action_submit_inspection" type="object" string="Submit Completed Work" class="oe_highlight" invisible="state != 'in_progress'"/><button name="action_accept" type="object" string="Accept Work" class="oe_highlight" groups="elmokrif_construction_control.group_construction_control_manager" invisible="state != 'inspection'"/><button name="action_close" type="object" string="Close" class="oe_highlight" invisible="state != 'accepted'"/><field name="state" widget="statusbar" statusbar_visible="draft,ready,released,in_progress,on_hold,inspection,accepted,closed"/></header>
        <sheet><div class="oe_button_box" name="button_box"><button name="action_view_tasks" type="object" class="oe_stat_button" icon="fa-tasks"><field name="task_count" widget="statinfo" string="Tasks"/></button></div><div class="oe_title"><label for="title"/><h1><field name="title"/></h1><field name="name"/></div>
        <group><group string="Scope"><field name="company_id"/><field name="chantier_id"/><field name="boq_id"/><field name="wbs_id"/><field name="boq_line_ids" widget="many2many_tags"/><field name="dependency_ids" widget="many2many_tags"/></group><group string="Responsibility and Dates"><field name="manager_id" widget="many2one_avatar_user"/><field name="responsible_id" widget="many2one_avatar_user"/><field name="contractor_id"/><field name="planned_start"/><field name="planned_finish"/><field name="actual_start"/><field name="actual_finish"/></group></group>
        <notebook><page string="Production"><group><group><field name="planned_quantity"/><field name="installed_quantity"/><field name="unit"/><field name="progress_percent" widget="progressbar"/></group><group><field name="planned_labor_hours"/><field name="inspection_required"/><field name="hold_reason" required="state == 'on_hold'"/></group></group></page>
        <page string="Readiness"><div class="alert alert-info" role="alert" invisible="state != 'draft'">Confirm each prerequisite before releasing work to the site.</div><group><field name="method_statement_ready"/><field name="drawings_ready"/><field name="permits_ready"/><field name="materials_ready"/></group><field name="attachment_ids" widget="many2many_binary"/></page>
        <page string="Budget"><group><field name="budget_material"/><field name="budget_labour"/><field name="budget_equipment"/><field name="budget_subcontract"/><field name="budget_total"/></group></page>
        <page string="Tasks"><field name="task_ids" context="{'default_project_id': chantier_id, 'default_work_package_id': id, 'default_chantier_bundle': title}"><tree editable="bottom"><field name="project_id" column_invisible="True"/><field name="name"/><field name="user_ids" widget="many2many_avatar_user"/><field name="date_deadline"/><field name="priority" widget="priority"/><field name="stage_id"/></tree></field></page></notebook>
        </sheet><div class="oe_chatter"><field name="message_follower_ids"/><field name="activity_ids"/><field name="message_ids"/></div></form></field></record>
    <record id="view_construction_work_package_kanban" model="ir.ui.view"><field name="name">construction.work.package.kanban</field><field name="model">construction.work.package</field><field name="arch" type="xml"><kanban default_group_by="state" class="o_kanban_small_column"><field name="name"/><field name="title"/><field name="responsible_id"/><field name="planned_finish"/><field name="progress_percent"/><templates><t t-name="kanban-box"><div class="oe_kanban_global_click o_kanban_record"><strong><field name="name"/> — <field name="title"/></strong><div><field name="responsible_id"/></div><div>Finish: <field name="planned_finish"/></div><field name="progress_percent" widget="progressbar"/></div></t></templates></kanban></field></record>
    <record id="view_construction_work_package_graph" model="ir.ui.view"><field name="name">construction.work.package.graph</field><field name="model">construction.work.package</field><field name="arch" type="xml"><graph string="Work Package Budget" type="bar"><field name="chantier_id"/><field name="budget_total" type="measure"/></graph></field></record>
    <record id="action_construction_work_package" model="ir.actions.act_window"><field name="name">Work Packages</field><field name="res_model">construction.work.package</field><field name="view_mode">kanban,tree,graph,pivot,form</field></record>

    <!-- Change events and variations -->
    <record id="view_construction_change_event_tree" model="ir.ui.view"><field name="name">construction.change.event.tree</field><field name="model">construction.change.event</field><field name="arch" type="xml"><tree><field name="company_id" column_invisible="True"/><field name="name"/><field name="title"/><field name="chantier_id"/><field name="event_date"/><field name="reason"/><field name="responsibility"/><field name="estimated_cost_impact" sum="Cost Exposure"/><field name="estimated_revenue_impact" sum="Revenue Exposure"/><field name="estimated_schedule_days"/><field name="owner_id"/><field name="state" widget="badge"/></tree></field></record>
    <record id="view_construction_change_event_form" model="ir.ui.view"><field name="name">construction.change.event.form</field><field name="model">construction.change.event</field><field name="arch" type="xml"><form>
        <header><button name="action_submit" type="object" string="Submit" class="oe_highlight" invisible="state != 'draft'"/><button name="action_estimate" type="object" string="Start Estimating" class="oe_highlight" invisible="state != 'submitted'"/><button name="action_review" type="object" string="Commercial Review" class="oe_highlight" invisible="state != 'estimating'"/><button name="action_accept" type="object" string="Accept for Variation" class="oe_highlight" groups="elmokrif_construction_control.group_construction_control_manager" invisible="state != 'review'"/><button name="action_reject" type="object" string="Reject" invisible="state not in ['submitted', 'estimating', 'review']"/><button name="action_create_variation" type="object" string="Create Variation Order" class="oe_highlight" groups="elmokrif_construction_control.group_construction_control_manager" invisible="state != 'accepted'"/><field name="state" widget="statusbar" statusbar_visible="draft,submitted,estimating,review,accepted,converted"/></header>
        <sheet><div class="oe_title"><label for="title"/><h1><field name="title"/></h1><field name="name"/></div><group><group><field name="company_id"/><field name="chantier_id"/><field name="event_date"/><field name="reason"/><field name="responsibility"/><field name="owner_id" widget="many2one_avatar_user"/></group><group><field name="issue_id"/><field name="rfi_id"/><field name="boq_line_id"/><field name="variation_order_id"/><field name="estimated_cost_impact"/><field name="estimated_revenue_impact"/><field name="estimated_schedule_days"/></group></group><notebook><page string="Description"><field name="description"/></page><page string="Evidence"><field name="attachment_ids" widget="many2many_binary"/></page><page string="Decision"><field name="decision_reason" required="state == 'rejected'"/></page></notebook></sheet><div class="oe_chatter"><field name="message_follower_ids"/><field name="activity_ids"/><field name="message_ids"/></div></form></field></record>
    <record id="view_construction_change_event_graph" model="ir.ui.view"><field name="name">construction.change.event.graph</field><field name="model">construction.change.event</field><field name="arch" type="xml"><graph string="Change Exposure" type="bar"><field name="reason"/><field name="estimated_cost_impact" type="measure"/><field name="estimated_revenue_impact" type="measure"/></graph></field></record>
    <record id="action_construction_change_event" model="ir.actions.act_window"><field name="name">Change Events</field><field name="res_model">construction.change.event</field><field name="view_mode">tree,graph,pivot,form</field></record>

    <record id="view_construction_variation_order_tree" model="ir.ui.view"><field name="name">construction.variation.order.tree</field><field name="model">construction.variation.order</field><field name="arch" type="xml"><tree><field name="company_id" column_invisible="True"/><field name="name"/><field name="title"/><field name="chantier_id"/><field name="customer_id"/><field name="cost_amount" sum="Approved/Pending Cost"/><field name="revenue_amount" sum="Approved/Pending Revenue"/><field name="margin_amount"/><field name="schedule_impact_days"/><field name="state" widget="badge"/></tree></field></record>
    <record id="view_construction_variation_order_form" model="ir.ui.view"><field name="name">construction.variation.order.form</field><field name="model">construction.variation.order</field><field name="arch" type="xml"><form>
        <header><button name="action_submit" type="object" string="Submit for Review" class="oe_highlight" invisible="state != 'draft'"/><button name="action_request_customer_approval" type="object" string="Request Customer Approval" class="oe_highlight" invisible="state != 'submitted'"/><button name="action_approve" type="object" string="Approve Variation" class="oe_highlight" groups="elmokrif_construction_control.group_construction_control_manager" invisible="state != 'customer'"/><button name="action_prepare_boq_revision" type="object" string="Prepare BOQ Revision" invisible="state != 'approved'"/><button name="action_implement" type="object" string="Mark Implemented" class="oe_highlight" invisible="state != 'approved'"/><field name="state" widget="statusbar" statusbar_visible="draft,submitted,customer,approved,implemented"/></header>
        <sheet><div class="oe_title"><label for="title"/><h1><field name="title"/></h1><field name="name"/></div><group><group><field name="company_id"/><field name="chantier_id"/><field name="customer_id"/><field name="change_event_ids" widget="many2many_tags"/><field name="baseline_boq_id"/><field name="revised_boq_id"/></group><group><field name="contractual_reference"/><field name="schedule_impact_days"/><field name="customer_approval_reference" required="state in ['approved', 'implemented']"/><field name="customer_approved_at"/><field name="approved_by_id"/><field name="approved_at"/></group></group><field name="reason"/>
        <field name="line_ids" readonly="state != 'draft'"><tree editable="bottom"><field name="company_id" column_invisible="True"/><field name="sequence" widget="handle"/><field name="boq_line_id"/><field name="description"/><field name="quantity_delta"/><field name="cost_amount" sum="Total Cost"/><field name="revenue_amount" sum="Total Revenue"/></tree></field>
        <group class="oe_subtotal_footer oe_right"><field name="cost_amount"/><field name="revenue_amount"/><field name="margin_amount"/></group><notebook><page string="Evidence"><field name="attachment_ids" widget="many2many_binary"/></page><page string="Audit"><group><field name="submitted_by_id"/><field name="submitted_at"/></group></page></notebook></sheet><div class="oe_chatter"><field name="message_follower_ids"/><field name="activity_ids"/><field name="message_ids"/></div></form></field></record>
    <record id="action_construction_variation_order" model="ir.actions.act_window"><field name="name">Variation Orders</field><field name="res_model">construction.variation.order</field><field name="view_mode">tree,form</field></record>

    <!-- Progress certificates -->
    <record id="view_construction_progress_certificate_tree" model="ir.ui.view"><field name="name">construction.progress.certificate.tree</field><field name="model">construction.progress.certificate</field><field name="arch" type="xml"><tree><field name="company_id" column_invisible="True"/><field name="name"/><field name="chantier_id"/><field name="customer_id"/><field name="period_start"/><field name="period_end"/><field name="gross_current" sum="Gross Certified"/><field name="retention_amount" sum="Retention"/><field name="net_current" sum="Net Certified"/><field name="invoice_id"/><field name="state" widget="badge"/></tree></field></record>
    <record id="view_construction_progress_certificate_form" model="ir.ui.view"><field name="name">construction.progress.certificate.form</field><field name="model">construction.progress.certificate</field><field name="arch" type="xml"><form>
        <header><button name="action_populate_boq" type="object" string="Load BOQ Lines" groups="elmokrif_construction_control.group_progress_certifier" invisible="state != 'draft'"/><button name="action_submit" type="object" string="Submit" class="oe_highlight" groups="elmokrif_construction_control.group_progress_certifier" invisible="state != 'draft'"/><button name="action_verify" type="object" string="Verify Measurement" class="oe_highlight" groups="elmokrif_construction_control.group_progress_certifier" invisible="state != 'submitted'"/><button name="action_approve" type="object" string="Approve Certificate" class="oe_highlight" groups="elmokrif_construction_control.group_construction_control_manager" invisible="state != 'verified'"/><button name="action_create_invoice" type="object" string="Create Invoice" class="oe_highlight" groups="account.group_account_invoice" invisible="state != 'approved'"/><button name="action_open_invoice" type="object" string="Open Invoice" invisible="not invoice_id"/><field name="state" widget="statusbar" statusbar_visible="draft,submitted,verified,approved,invoiced"/></header>
        <sheet><div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div><group><group><field name="company_id"/><field name="chantier_id"/><field name="customer_id"/><field name="boq_id"/><field name="sale_order_id"/><field name="billing_product_id"/></group><group><field name="period_start"/><field name="period_end"/><field name="retention_percent"/><field name="advance_recovery_percent"/><field name="tax_ids" widget="many2many_tags"/><field name="customer_certificate_reference" required="state in ['approved', 'invoiced']"/></group></group>
        <field name="line_ids" readonly="state != 'draft'"><tree editable="bottom"><field name="company_id" column_invisible="True"/><field name="boq_line_id"/><field name="description"/><field name="contract_quantity"/><field name="previous_quantity" readonly="1"/><field name="current_quantity"/><field name="cumulative_quantity" readonly="1"/><field name="unit_rate"/><field name="current_amount" sum="Current Gross" readonly="1"/><field name="cumulative_amount" readonly="1"/></tree></field>
        <group class="oe_subtotal_footer oe_right"><field name="gross_current"/><field name="retention_amount"/><field name="advance_recovery_amount"/><field name="net_current" class="oe_subtotal_footer_separator"/></group>
