<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_site_issue_scope" model="ir.rule">
        <field name="name">Site issues: assigned chantier and company</field>
        <field name="model_id" ref="model_construction_site_issue"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids), '|', ('chantier_id.user_id', '=', user.id), ('chantier_id.chantier_member_ids', 'in', [user.id])]</field>
