<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_construction_control" model="ir.module.category">
        <field name="name">Construction Control</field>
        <field name="sequence">37</field>
    </record>

    <record id="group_construction_control_user" model="res.groups">
        <field name="name">Construction Control User</field>
        <field name="category_id" ref="module_category_construction_control"/>
    </record>
    <record id="group_progress_certifier" model="res.groups">
        <field name="name">Progress Certificate Preparer / Verifier</field>
        <field name="category_id" ref="module_category_construction_control"/>
        <field name="implied_ids" eval="[(4, ref('group_construction_control_user'))]"/>
    </record>
    <record id="group_construction_control_manager" model="res.groups">
        <field name="name">Construction Control Manager</field>
        <field name="category_id" ref="module_category_construction_control"/>
        <field name="implied_ids" eval="[(4, ref('group_construction_control_user')), (4, ref('group_progress_certifier'))]"/>
    </record>

    <record id="elmokrif_chantier.group_chantier_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_construction_control_user'))]"/>
    </record>
    <record id="elmokrif_chantier.group_chantier_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_construction_control_manager'))]"/>
    </record>
    <record id="elmokrif_purchase_quality.group_chantier_purchase_approver" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_progress_certifier'))]"/>
    </record>
    <record id="account.group_account_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_progress_certifier'))]"/>
    </record>
</odoo>
