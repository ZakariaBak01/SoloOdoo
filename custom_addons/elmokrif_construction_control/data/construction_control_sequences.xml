<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_construction_site_issue" model="ir.sequence">
        <field name="name">Construction Site Issue</field><field name="code">construction.site.issue</field>
        <field name="prefix">ISS/%(year)s/</field><field name="padding">5</field><field name="company_id" eval="False"/>
    </record>
    <record id="seq_construction_rfi" model="ir.sequence">
        <field name="name">Construction RFI</field><field name="code">construction.rfi</field>
        <field name="prefix">RFI/%(year)s/</field><field name="padding">5</field><field name="company_id" eval="False"/>
    </record>
    <record id="seq_construction_submittal" model="ir.sequence">
        <field name="name">Construction Submittal</field><field name="code">construction.submittal</field>
        <field name="prefix">SUB/%(year)s/</field><field name="padding">5</field><field name="company_id" eval="False"/>
    </record>
    <record id="seq_construction_work_package" model="ir.sequence">
        <field name="name">Construction Work Package</field><field name="code">construction.work.package</field>
        <field name="prefix">WP/%(year)s/</field><field name="padding">5</field><field name="company_id" eval="False"/>
