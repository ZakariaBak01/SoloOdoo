<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_partner_form_sale_chantier" model="ir.ui.view">
        <field name="name">res.partner.form.sale.chantier</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="default_chantier_id"
                       domain="[('is_chantier', '=', True), '|', ('company_id', '=', False), ('company_id', '=', company_id)]"
                       options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
