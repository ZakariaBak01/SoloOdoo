<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_company_form_sale_chantier" model="ir.ui.view">
        <field name="name">res.company.form.sale.chantier</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="sale_chantier_followup_delay_days"/>
                <field name="sale_chantier_followup_activity_type_id"/>
            </xpath>
        </field>
    </record>
</odoo>
