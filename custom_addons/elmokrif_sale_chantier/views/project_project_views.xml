<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_project_form_sale_chantier" model="ir.ui.view">
        <field name="name">project.project.form.sale.chantier</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="elmokrif_chantier.project_project_form_chantier"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_sale_orders"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-shopping-cart"
                        invisible="not is_chantier"
                        groups="sales_team.group_sale_salesman">
                    <field name="sale_order_count" widget="statinfo" string="Sales"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
