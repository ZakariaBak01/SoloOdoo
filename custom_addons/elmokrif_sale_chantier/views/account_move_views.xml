<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="account_move_form_chantier" model="ir.ui.view">
        <field name="name">account.move.form.chantier</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="chantier_id" options="{'no_create': True}"/>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//field[@name='product_id']" position="after">
                <field name="chantier_id" optional="show" options="{'no_create': True}"/>
                <field name="chantier_origin_id" optional="hide"/>
                <field name="sale_line_id" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
