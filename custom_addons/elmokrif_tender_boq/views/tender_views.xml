<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_tender_search" model="ir.ui.view"><field name="name">construction.tender.search</field><field name="model">construction.tender</field><field name="arch" type="xml"><search><field name="name"/><field name="title"/><field name="chantier_id"/><field name="boq_id"/><field name="buyer_id"/><filter name="active_procurement" string="Active" domain="[('state', 'not in', ['awarded', 'cancelled'])]"/><group expand="0" string="Group By"><filter name="group_chantier" string="Chantier" context="{'group_by':'chantier_id'}"/><filter name="group_state" string="Status" context="{'group_by':'state'}"/><filter name="group_buyer" string="Buyer" context="{'group_by':'buyer_id'}"/></group></search></field></record>
    <record id="view_construction_tender_tree" model="ir.ui.view"><field name="name">construction.tender.tree</field><field name="model">construction.tender</field><field name="arch" type="xml"><tree decoration-success="state == 'awarded'" decoration-muted="state == 'cancelled'"><field name="name"/><field name="title"/><field name="chantier_id"/><field name="package_code"/><field name="tender_type"/><field name="submission_deadline"/><field name="buyer_id"/><field name="state" widget="badge"/></tree></field></record>

    <record id="view_construction_tender_bid_form" model="ir.ui.view"><field name="name">construction.tender.bid.form</field><field name="model">construction.tender.bid</field><field name="arch" type="xml"><form string="Tender Bid">
        <header><button name="action_populate_from_boq" type="object" string="Load BOQ" class="oe_highlight" invisible="state not in ['invited', 'preparation', 'clarification']"/><button name="action_submit" type="object" string="Submit Bid" class="oe_highlight" invisible="state not in ['invited', 'preparation', 'clarification']"/><button name="action_complete_evaluation" type="object" string="Complete Technical Evaluation" groups="elmokrif_tender_boq.group_tender_evaluator" invisible="state != 'opened'"/><button name="action_create_clarification_round" type="object" string="New Clarification Round" invisible="state not in ['opened', 'evaluated']"/><button name="action_prepare_award" type="object" string="Prepare Award" class="oe_highlight" groups="elmokrif_tender_boq.group_tender_buyer" invisible="state != 'evaluated' or not technical_compliant"/><field name="state" widget="statusbar"/></header>
        <sheet><field name="company_id" invisible="1"/><widget name="web_ribbon" title="Technically Non-compliant" bg_color="text-bg-danger" invisible="state != 'evaluated' or technical_compliant"/><div class="oe_title"><label for="partner_id"/><h1><field name="partner_id" options="{'no_create': True}"/></h1><h2><field name="reference" placeholder="Bidder reference"/></h2></div>
            <group><group><field name="tender_id" options="{'no_create': True}"/><field name="bid_round"/><field name="parent_bid_id"/><field name="currency_id"/><field name="locked_company_rate"/><field name="submission_date"/></group><group><field name="validity_date"/><field name="delivery_days"/><field name="payment_term_id"/><field name="retention_percent"/><field name="advance_percent"/><field name="warranty_months"/></group></group>
            <notebook><page string="Priced BOQ"><field name="line_ids" context="{'default_bid_id': id}"><tree editable="bottom" decoration-danger="no_bid" decoration-warning="technical_compliance != 'compliant'"><field name="boq_line_id" options="{'no_create': True}"/><field name="quoted_quantity"/><field name="uom_id"/><field name="quoted_unit_rate"/><field name="discount_percent" optional="show"/><field name="freight_amount" optional="hide"/><field name="exclusion_adjustment" optional="hide"/><field name="commercial_adjustment" optional="hide"/><field name="quoted_amount" readonly="1" sum="Quoted Total"/><field name="normalized_amount" readonly="1" sum="Normalized Total"/><field name="variance_percent" readonly="1"/><field name="technical_compliance"/><field name="no_bid"/><field name="alternative_no" optional="hide"/></tree></field></page>
                <page string="Evaluation"><field name="score_ids" context="{'default_bid_id': id}"><tree editable="bottom"><field name="criterion_id" options="{'no_create': True}"/><field name="evaluator_id" readonly="1"/><field name="score"/><field name="comment"/></tree></field><group><group><field name="technical_compliant"/><field name="technical_score"/><field name="delivery_score"/><field name="risk_score"/></group><group><field name="commercial_score"/><field name="final_score"/><field name="rank"/><field name="completeness_percent" widget="percentage"/></group></group></page>
                <page string="Qualifications"><group><field name="deviation_notes" placeholder="List qualifications and deviations"/><field name="exclusion_notes" placeholder="List all exclusions"/><field name="attachment_ids" widget="many2many_binary"/></group></page>
            </notebook><group class="oe_subtotal_footer oe_right"><field name="quoted_total"/><field name="normalized_total"/></group>
        </sheet><chatter/>
    </form></field></record>
    <record id="view_construction_tender_bid_tree" model="ir.ui.view"><field name="name">construction.tender.bid.tree</field><field name="model">construction.tender.bid</field><field name="arch" type="xml"><tree decoration-success="state == 'awarded'" decoration-danger="state == 'evaluated' and not technical_compliant"><field name="tender_id"/><field name="partner_id"/><field name="bid_round"/><field name="currency_id"/><field name="quoted_total"/><field name="normalized_total"/><field name="completeness_percent" widget="percentage"/><field name="technical_compliant"/><field name="final_score"/><field name="rank"/><field name="state" widget="badge"/></tree></field></record>

    <record id="view_construction_tender_comparison_form" model="ir.ui.view"><field name="name">construction.tender.comparison.form</field><field name="model">construction.tender.comparison</field><field name="arch" type="xml"><form string="Tender Comparison"><header><field name="state" widget="statusbar"/></header><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><field name="tender_id"/><field name="snapshot_at"/><field name="snapshot_by_id"/><field name="content_hash"/></group><field name="line_ids" readonly="1"><tree decoration-success="rank == 1"><field name="rank"/><field name="partner_id"/><field name="quoted_total"/><field name="normalized_total"/><field name="completeness_percent" widget="percentage"/><field name="technical_compliant"/><field name="technical_score"/><field name="commercial_score"/><field name="delivery_score"/><field name="risk_score"/><field name="final_score"/></tree></field></sheet><chatter/></form></field></record>
    <record id="view_construction_tender_comparison_tree" model="ir.ui.view"><field name="name">construction.tender.comparison.tree</field><field name="model">construction.tender.comparison</field><field name="arch" type="xml"><tree><field name="name"/><field name="tender_id"/><field name="snapshot_at"/><field name="snapshot_by_id"/><field name="state" widget="badge"/></tree></field></record>

    <record id="view_construction_tender_award_form" model="ir.ui.view"><field name="name">construction.tender.award.form</field><field name="model">construction.tender.award</field><field name="arch" type="xml"><form string="Tender Award"><header><button name="action_recommend" type="object" string="Submit Recommendation" class="oe_highlight" invisible="state != 'draft'"/><button name="action_approve" type="object" string="Approve Award" class="oe_highlight" groups="elmokrif_tender_boq.group_tender_award_approver" invisible="state != 'recommended'"/><button name="action_open_purchase_order" type="object" string="Create Purchase Order" class="oe_highlight" invisible="state != 'approved'"/><field name="state" widget="statusbar"/></header><sheet><div class="oe_button_box" name="button_box"><button name="action_open_purchase_order" type="object" class="oe_stat_button" icon="fa-shopping-cart" invisible="not purchase_order_id"><field name="purchase_order_id" widget="statinfo" string="Purchase Order"/></button></div><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="tender_id" options="{'no_create': True}"/><field name="comparison_id" options="{'no_create': True}"/><field name="bid_id" options="{'no_create': True}"/><field name="partner_id"/></group><group><field name="approved_by_id"/><field name="approved_at"/><field name="purchase_order_id"/></group></group><field name="recommendation_reason" placeholder="State the commercial, technical and risk basis for this award"/><field name="line_ids" context="{'default_award_id': id}"><tree editable="bottom"><field name="bid_line_id" options="{'no_create': True}"/><field name="boq_line_id"/><field name="awarded_quantity"/><field name="awarded_unit_rate"/><field name="awarded_amount" readonly="1" sum="Award Total"/></tree></field></sheet><chatter/></form></field></record>
    <record id="view_construction_tender_award_tree" model="ir.ui.view"><field name="name">construction.tender.award.tree</field><field name="model">construction.tender.award</field><field name="arch" type="xml"><tree decoration-success="state in ['approved', 'converted']"><field name="name"/><field name="tender_id"/><field name="partner_id"/><field name="currency_id"/><field name="approved_by_id"/><field name="purchase_order_id"/><field name="state" widget="badge"/></tree></field></record>

    <record id="view_construction_tender_form" model="ir.ui.view"><field name="name">construction.tender.form</field><field name="model">construction.tender</field><field name="arch" type="xml"><form string="Construction Tender">
        <header><button name="action_approve_issue" type="object" string="Approve for Issue" class="oe_highlight" groups="elmokrif_tender_boq.group_tender_manager" invisible="state != 'draft'"/><button name="action_issue" type="object" string="Issue Tender" class="oe_highlight" groups="elmokrif_tender_boq.group_tender_manager" invisible="state != 'approved_issue'"/><button name="action_close_bids" type="object" string="Close Bids" groups="elmokrif_tender_boq.group_tender_manager" invisible="state not in ['issued', 'clarification']"/><button name="action_start_technical_evaluation" type="object" string="Start Technical Evaluation" groups="elmokrif_tender_boq.group_tender_manager" invisible="state != 'closed'"/><button name="action_start_commercial_evaluation" type="object" string="Start Commercial Evaluation" groups="elmokrif_tender_boq.group_tender_manager" invisible="state != 'technical'"/><button name="action_open_comparison" type="object" string="Build Comparison" class="oe_highlight" groups="elmokrif_tender_boq.group_tender_manager" invisible="state not in ['commercial', 'recommendation']"/><field name="state" widget="statusbar" statusbar_visible="draft,approved_issue,issued,closed,technical,commercial,recommendation,awarded"/></header>
        <sheet><widget name="web_ribbon" title="Awarded" bg_color="text-bg-success" invisible="state != 'awarded'"/><div class="oe_title"><label for="title"/><h1><field name="title" placeholder="Tender package title"/></h1><h2><field name="name"/></h2></div>
            <group><group><field name="company_id" invisible="1"/><field name="chantier_id" options="{'no_create': True}"/><field name="boq_id" domain="[('chantier_id', '=', chantier_id), ('state', 'in', ['approved', 'issued'])]" options="{'no_create': True}"/><field name="tender_type"/><field name="package_code"/></group><group><field name="buyer_id"/><field name="tender_manager_id"/><field name="evaluation_committee_ids" widget="many2many_avatar_user"/><field name="clarification_deadline"/><field name="submission_deadline"/><field name="issue_date"/><field name="closing_date"/></group></group>
            <notebook><page string="Invited Bidders"><field name="bid_ids" context="{'default_tender_id': id}"><tree><field name="partner_id"/><field name="bid_round"/><field name="currency_id"/><field name="quoted_total"/><field name="normalized_total"/><field name="completeness_percent" widget="percentage"/><field name="technical_compliant"/><field name="final_score"/><field name="rank"/><field name="state" widget="badge"/></tree></field></page>
                <page string="Evaluation Matrix"><group string="Overall Weights"><field name="technical_weight"/><field name="commercial_weight"/><field name="delivery_weight"/><field name="risk_weight"/></group><field name="criterion_ids" context="{'default_tender_id': id}"><tree editable="bottom"><field name="sequence" widget="handle"/><field name="name"/><field name="category"/><field name="weight"/><field name="mandatory"/><field name="minimum_score"/></tree></field></page>
                <page string="Comparisons"><field name="comparison_ids" readonly="1"><tree><field name="name"/><field name="snapshot_at"/><field name="snapshot_by_id"/><field name="state" widget="badge"/></tree></field></page>
                <page string="Awards"><field name="award_ids" readonly="1"><tree><field name="name"/><field name="partner_id"/><field name="approved_by_id"/><field name="purchase_order_id"/><field name="state" widget="badge"/></tree></field></page>
                <page string="Documents"><field name="attachment_ids" widget="many2many_binary"/></page><page string="Approval Evidence"><group><field name="approved_for_issue_by_id"/><field name="approved_for_issue_at"/><field name="award_approved_by_id"/><field name="award_approved_at"/></group></page>
            </notebook>
        </sheet><chatter/>
    </form></field></record>

    <record id="action_construction_tender" model="ir.actions.act_window"><field name="name">Tenders</field><field name="res_model">construction.tender</field><field name="view_mode">tree,form</field><field name="search_view_id" ref="view_construction_tender_search"/><field name="context">{'search_default_active_procurement': 1}</field></record>
    <record id="action_construction_tender_bid" model="ir.actions.act_window"><field name="name">Tender Bids</field><field name="res_model">construction.tender.bid</field><field name="view_mode">tree,form</field></record>
    <record id="action_construction_tender_comparison" model="ir.actions.act_window"><field name="name">Bid Comparisons</field><field name="res_model">construction.tender.comparison</field><field name="view_mode">tree,form</field></record>
    <record id="action_construction_tender_award" model="ir.actions.act_window"><field name="name">Tender Awards</field><field name="res_model">construction.tender.award</field><field name="view_mode">tree,form</field></record>
</odoo>
