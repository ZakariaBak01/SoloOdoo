<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_boq_return_wizard_form" model="ir.ui.view">
        <field name="name">construction.boq.return.wizard.form</field><field name="model">construction.boq.return.wizard</field>
        <field name="arch" type="xml"><form string="Request BOQ Changes"><group><field name="boq_id"/><field name="reason" placeholder="Describe the exact correction required and its reason"/></group><footer><button name="action_confirm" type="object" string="Request Changes" class="btn-primary"/><button string="Cancel" special="cancel" class="btn-secondary"/></footer></form></field>
    </record>
    <record id="view_boq_revision_wizard_form" model="ir.ui.view">
        <field name="name">construction.boq.revision.wizard.form</field><field name="model">construction.boq.revision.wizard</field>
        <field name="arch" type="xml"><form string="Create BOQ Revision"><group><field name="boq_id"/><field name="reason" placeholder="Contractual, design or commercial reason for the revision"/></group><footer><button name="action_confirm" type="object" string="Create Revision" class="btn-primary"/><button string="Cancel" special="cancel" class="btn-secondary"/></footer></form></field>
    </record>
</odoo>
