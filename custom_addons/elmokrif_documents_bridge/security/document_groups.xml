<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_elmokrif_documents" model="ir.module.category">
        <field name="name">EL MOKRIF Documents</field>
        <field name="sequence">50</field>
    </record>
    <record id="group_elmokrif_document_user" model="res.groups">
        <field name="name">Document User</field>
        <field name="category_id" ref="module_category_elmokrif_documents"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_elmokrif_document_manager" model="res.groups">
        <field name="name">Document Manager</field>
        <field name="category_id" ref="module_category_elmokrif_documents"/>
        <field name="implied_ids" eval="[(4, ref('elmokrif_documents_bridge.group_elmokrif_document_user'))]"/>
    </record>
</odoo>
