<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_elmokrif_document_company" model="ir.rule">
        <field name="name">Documents: assigned chantier or owner</field>
        <field name="model_id" ref="model_elmokrif_document"/>
        <field name="domain_force">[
            '&amp;',
                ('company_id', 'in', company_ids),
                '|', '|', '|', '|',
                    ('owner_id', '=', user.id),
                    ('chantier_id', '=', False),
                    ('chantier_id.user_id', '=', user.id),
                    ('chantier_id.chantier_member_ids', 'in', [user.id]),
                    ('chantier_id.sales_user_ids', 'in', [user.id])
        ]</field>
        <field name="groups" eval="[(4, ref('elmokrif_documents_bridge.group_elmokrif_document_user'))]"/>
    </record>
    <record id="rule_elmokrif_document_manager_company" model="ir.rule">
        <field name="name">Documents: managers in allowed companies</field>
        <field name="model_id" ref="model_elmokrif_document"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('elmokrif_documents_bridge.group_elmokrif_document_manager'))]"/>
    </record>
</odoo>
