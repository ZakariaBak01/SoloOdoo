<?xml version="1.0" encoding="utf-8"?>
<odoo>
 <record id="action_material_request" model="ir.actions.act_window"><field name="name">Material Requests</field><field name="res_model">chantier.material.request</field><field name="view_mode">tree,form</field></record>
 <menuitem id="menu_material_request" name="Material Requests" parent="elmokrif_chantier.menu_chantier_root" action="action_material_request" sequence="10" groups="elmokrif_chantier.group_chantier_user"/>
 <record id="view_material_request_tree" model="ir.ui.view"><field name="name">chantier.material.request.tree</field><field name="model">chantier.material.request</field><field name="arch" type="xml"><tree><field name="name"/><field name="chantier_id"/><field name="request_date"/><field name="state"/></tree></field></record>
 <record id="view_material_request_form" model="ir.ui.view"><field name="name">chantier.material.request.form</field><field name="model">chantier.material.request</field><field name="arch" type="xml"><form><header><button name="action_submit" type="object" string="Submit" invisible="state != 'draft'"/><button name="action_approve" type="object" string="Approve" groups="elmokrif_chantier.group_chantier_manager" invisible="state != 'submitted'"/><button name="action_create_transfer" type="object" string="Create Warehouse Transfer" groups="elmokrif_chantier.group_chantier_manager" invisible="state != 'approved' or picking_id"/><button name="action_cancel" type="object" string="Cancel" invisible="state not in ['draft', 'submitted']"/><field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,partially_delivered,done,cancel"/></header><sheet><group><field name="company_id" invisible="1"/><field name="name"/><field name="chantier_id" readonly="state != 'draft'"/><field name="warehouse_id"/><field name="location_dest_id"/><field name="request_date"/><field name="picking_id" readonly="1"/></group><field name="line_ids" readonly="state != 'draft'"><tree editable="bottom"><field name="product_id"/><field name="product_uom_qty"/><field name="product_uom_id"/><field name="delivered_qty" readonly="1"/></tree></field></sheet><chatter/></form></field></record>
</odoo>
