<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_chantier_material_request_company" model="ir.rule">
        <field name="name">Material requests: allowed companies</field>
        <field name="model_id" ref="model_chantier_material_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('elmokrif_chantier.group_chantier_user'))]"/>
    </record>
    <record id="rule_chantier_material_request_line_company" model="ir.rule">
        <field name="name">Material request lines: allowed companies</field>
        <field name="model_id" ref="model_chantier_material_request_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('elmokrif_chantier.group_chantier_user'))]"/>
    </record>
</odoo>
