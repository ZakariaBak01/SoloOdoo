<odoo>
 <record id="action_chantier_estimation" model="ir.actions.act_window"><field name="name">Construction Estimates</field><field name="res_model">chantier.estimation</field><field name="view_mode">tree,form</field></record>
 <menuitem id="menu_chantier_estimation" name="Construction Estimates" parent="elmokrif_chantier.menu_chantier_root" action="action_chantier_estimation" sequence="15" groups="elmokrif_chantier.group_chantier_user"/>
 <record id="view_chantier_estimation_tree" model="ir.ui.view"><field name="name">chantier.estimation.tree</field><field name="model">chantier.estimation</field><field name="arch" type="xml"><tree><field name="name"/><field name="chantier_id"/><field name="structure_type"/><field name="net_volume"/><field name="adjusted_volume"/><field name="total_cost"/></tree></field></record>
 <record id="view_chantier_estimation_form" model="ir.ui.view"><field name="name">chantier.estimation.form</field><field name="model">chantier.estimation</field><field name="arch" type="xml"><form><sheet><div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div><group><group string="Site and Dimensions"><field name="chantier_id"/><field name="company_id" invisible="1"/><field name="structure_type"/><field name="length"/><field name="width"/><field name="depth"/><field name="net_volume" readonly="1"/></group><group string="Allowances"><field name="expansion_percent"/><field name="compaction_percent"/><field name="wastage_percent"/><field name="adjusted_volume" readonly="1"/><field name="truck_capacity_m3"/><field name="truck_trips" readonly="1"/></group></group><notebook><page string="Materials"><group><group><field name="cement_kg_per_m3"/><field name="bag_weight_kg"/><field name="cement_kg" readonly="1"/><field name="cement_bags" readonly="1"/><field name="cement_bag_cost"/></group><group><field name="sand_ratio"/><field name="gravel_ratio"/><field name="water_l_per_m3"/><field name="sand_volume" readonly="1"/><field name="gravel_volume" readonly="1"/><field name="water_litres" readonly="1"/></group></group><group><field name="sand_cost_m3"/><field name="gravel_cost_m3"/><field name="water_cost_litre"/><field name="material_cost" readonly="1"/></group></page><page string="Labour and Machinery"><group><group><field name="productivity_m3_per_day"/><field name="hours_per_day"/><field name="team_days" readonly="1"/><field name="labor_hours" readonly="1"/><field name="labor_hourly_cost"/><field name="labor_cost" readonly="1"/></group><group><field name="machinery_daily_cost"/><field name="machinery_cost" readonly="1"/><field name="truck_trip_cost"/><field name="logistics_cost" readonly="1"/></group></group></page><page string="Cost Summary"><group><group string="Tax and Contingency"><field name="subtotal" readonly="1"/><field name="contingency_percent"/><field name="contingency_amount" readonly="1"/><field name="tax_id"/><field name="tax_amount" readonly="1"/><field name="total_cost" readonly="1" class="oe_inline"/></group><group string="Phased Cash Flow"><field name="foundation_percent"/><field name="foundation_cost" readonly="1"/><field name="superstructure_percent"/><field name="superstructure_cost" readonly="1"/><field name="finishing_percent"/><field name="finishing_cost" readonly="1"/></group></group></page></notebook></sheet><chatter/></form></field></record>
 <record id="view_chantier_estimation_live_control" model="ir.ui.view"><field name="name">chantier.estimation.live.control</field><field name="model">chantier.estimation</field><field name="inherit_id" ref="view_chantier_estimation_form"/><field name="arch" type="xml"><xpath expr="//notebook" position="inside"><page string="Live Cost Control"><group><group string="Progress"><field name="task_count" readonly="1"/><field name="completed_task_count" readonly="1"/><field name="manual_progress_percent" invisible="task_count != 0"/><field name="progress_percent" readonly="1" widget="percentage"/><field name="expected_cost_at_progress" readonly="1"/></group><group string="Actual Costs"><field name="actual_material_cost" readonly="1"/><field name="actual_labor_hours"/><field name="actual_labor_cost" readonly="1"/><field name="actual_machinery_cost"/><field name="actual_other_cost"/></group></group><group string="Live Variance"><field name="actual_cost" readonly="1"/><field name="cost_variance" readonly="1"/><field name="budget_consumed_percent" readonly="1" widget="percentage"/><field name="schedule_variance_percent" readonly="1" widget="percentage"/></group><div class="alert alert-warning" role="alert" invisible="budget_consumed_percent &lt;= progress_percent">Cost consumption is ahead of recorded chantier progress. Review purchases, labour, and scope.</div></page></xpath></field></record>
<record id="view_chantier_estimation_workflow" model="ir.ui.view"><field name="name">chantier.estimation.workflow</field><field name="model">chantier.estimation</field><field name="inherit_id" ref="view_chantier_estimation_form"/><field name="arch" type="xml"><xpath expr="//form" position="inside"><header><button name="action_submit" type="object" string="Submit" invisible="state != 'draft'"/><button name="action_approve" type="object" string="Approve" groups="elmokrif_chantier.group_chantier_manager" invisible="state != 'submitted'"/><button name="action_new_revision" type="object" string="Create Revision" invisible="state != 'approved'"/><button name="action_approve_variance" type="object" string="Approve Variance" groups="elmokrif_chantier.group_chantier_manager" invisible="variance_approved_by_id"/><field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,superseded"/></header></xpath><xpath expr="//sheet" position="inside"><group invisible="not revision_of_id"><field name="revision_of_id" readonly="1"/><field name="approved_by_id" readonly="1"/><field name="approved_at" readonly="1"/><field name="variance_approved_by_id" readonly="1"/></group></xpath></field></record>
  <record id="view_chantier_estimation_workflow_flags" model="ir.ui.view"><field name="name">chantier.estimation.workflow.flags</field><field name="model">chantier.estimation</field><field name="inherit_id" ref="view_chantier_estimation_workflow"/><field name="arch" type="xml"><xpath expr="//sheet" position="inside"><field name="over_budget" invisible="1"/></xpath></field></record>
  <record id="view_chantier_estimation_form_usability" model="ir.ui.view">
    <field name="name">chantier.estimation.form.usability</field>
    <field name="model">chantier.estimation</field>
    <field name="inherit_id" ref="view_chantier_estimation_workflow"/>
    <field name="arch" type="xml">
      <!-- The inherited workflow header was appended after the sheet. Put it in
           the native top action bar so it remains visible while editing. -->
      <xpath expr="//form/header" position="replace"/>
      <xpath expr="//form/sheet" position="before">
        <header>
          <button name="action_submit" type="object" string="Submit" invisible="state != 'draft'"/>
          <button name="action_approve" type="object" string="Approve" groups="elmokrif_chantier.group_chantier_manager" invisible="state != 'submitted'"/>
          <button name="action_new_revision" type="object" string="Create Revision" invisible="state != 'approved'"/>
          <button name="action_approve_variance" type="object" string="Approve Variance" groups="elmokrif_chantier.group_chantier_manager" invisible="variance_approved_by_id"/>
          <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,superseded"/>
        </header>
      </xpath>
      <xpath expr="//field[@name='chantier_id']" position="attributes">
        <attribute name="placeholder">Select an existing chantier</attribute>
        <attribute name="domain">[('is_chantier', '=', True)]</attribute>
        <attribute name="options">{'no_create': True, 'no_create_edit': True}</attribute>
      </xpath>
      <xpath expr="//form/sheet/div[hasclass('oe_title')]" position="after">
        <div class="alert alert-info" role="status" invisible="chantier_id">
          Select the existing chantier for this estimate. Opening <b>Estimates</b> from a chantier automatically fills this field.
        </div>
        <div class="alert alert-info" role="status" invisible="not revision_of_id">
          This estimate revises the approved baseline shown below. That baseline remains active until this revision is approved.
        </div>
      </xpath>
    </field>
  </record>
</odoo>
