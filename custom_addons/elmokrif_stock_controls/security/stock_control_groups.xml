<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_chantier_consumption_user" model="res.groups">
        <field name="name">Chantier Consumption User</field>
        <field name="category_id" ref="base.module_category_inventory_inventory"/>
        <field name="implied_ids" eval="[(4, ref('elmokrif_chantier.group_chantier_user'))]"/>
    </record>
    <record id="group_chantier_consumption_approver" model="res.groups">
        <field name="name">Chantier Consumption Approver</field>
        <field name="category_id" ref="base.module_category_inventory_inventory"/>
        <field name="implied_ids" eval="[(4, ref('elmokrif_stock_controls.group_chantier_consumption_user')), (4, ref('elmokrif_chantier.group_chantier_manager'))]"/>
    </record>
</odoo>
