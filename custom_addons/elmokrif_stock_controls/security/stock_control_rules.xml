<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_chantier_consumption_company" model="ir.rule">
        <field name="name">Consumption: allowed companies</field><field name="model_id" ref="model_chantier_material_consumption"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('elmokrif_stock_controls.group_chantier_consumption_user'))]"/>
    </record>
    <record id="rule_chantier_consumption_line_company" model="ir.rule">
        <field name="name">Consumption lines: allowed companies</field><field name="model_id" ref="model_chantier_material_consumption_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('elmokrif_stock_controls.group_chantier_consumption_user'))]"/>
    </record>
</odoo>
