<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_leave_form_extension" model="ir.ui.view">
        <field name="name">hr.leave.form.elmokrif.extension</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="hr_approval_completed_at" readonly="1"/>
                <field name="hr_refusal_reason"
                       groups="hr.group_hr_user"
                       readonly="state in ['refuse', 'cancel', 'validate']"/>
            </xpath>
        </field>
    </record>
</odoo>
