<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_hr_appraisal_employee_scope" model="ir.rule">
        <field name="name">Appraisals: employee or manager scope</field>
        <field name="model_id" ref="model_elmokrif_hr_appraisal"/>
        <field name="domain_force">[
            '|',
                ('employee_id.user_id', '=', user.id),
                ('manager_id', '=', user.id)
        ]</field>
        <field name="groups" eval="[(4, ref('elmokrif_hr_extension.group_hr_employee'))]"/>
    </record>
    <record id="rule_hr_appraisal_officer_scope" model="ir.rule">
        <field name="name">Appraisals: HR company scope</field>
        <field name="model_id" ref="model_elmokrif_hr_appraisal"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('elmokrif_hr_extension.group_hr_officer'))]"/>
    </record>
    <record id="rule_hr_leave_self_service" model="ir.rule">
        <field name="name">Leave: employee self-service scope</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('elmokrif_hr_extension.group_hr_employee'))]"/>
    </record>
    <record id="rule_hr_leave_officer_scope" model="ir.rule">
        <field name="name">Leave: HR company scope</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('elmokrif_hr_extension.group_hr_officer'))]"/>
    </record>
</odoo>
