<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_lead_form_calendar_elmokrif" model="ir.ui.view">
        <field name="name">crm.lead.form.calendar.elmokrif</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_create_chantier_site_visit_event" type="object" string="Create Site Visit" class="btn-secondary" invisible="type == 'lead'"/>
            </xpath>
        </field>
    </record>
</odoo>
